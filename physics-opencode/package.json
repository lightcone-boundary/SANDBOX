{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@lightcone-boundary/sandbox",
  "version": "0.2.0",
  "type": "module",
  "description": "Native OpenCode plugin and CLI for the SANDBOX physics research assistant.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "sandbox": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lightcone-boundary/SANDBOX.git",
    "directory": "physics-opencode"
  },
  "keywords": [
    "opencode",
    "physics",
    "arxiv",
    "research",
    "plugin"
  ],
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/postbuild.mjs",
    "test": "bun test",
    "test:package": "bun scripts/test-package.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.22",
    "cross-spawn": "7.0.6",
    "fast-xml-parser": "5.11.0",
    "tar": "7.5.22",
    "tar-stream": "3.2.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.19.24",
    "@types/tar-stream": "3.1.4",
    "typescript": "^5.9.3"
  }
}
